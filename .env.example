# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and read automatically by `npm run dev` and `npm start`,
# so you never have to type these again. NEVER commit real values.

# Claude API key — enables the live two-agent pipeline on arbitrary code.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Enterprise Console ("Final product") owner sign-in.
# Email defaults to the owner address; set the passcode to whatever you like.
# On Vercel: Settings -> Environment Variables -> add both -> redeploy.
PLATFORM_EMAIL=aadijindal258@gmail.com
PLATFORM_PASSCODE=choose-a-passcode-here
