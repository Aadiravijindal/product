# Copy to .env.local and fill in. .env.local is gitignored and auto-loaded by
# `npm run dev` / `npm start`. NEVER commit real values.

# --- Core: live AI pipeline ---
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- Enterprise Console owner sign-in ---
PLATFORM_EMAIL=aadijindal258@gmail.com
PLATFORM_PASSCODE=choose-a-passcode-here
# Optional team members (share the passcode in this preview): email:role,email:role
# role is "approver" (can approve merges) or "viewer" (read-only)
PLATFORM_TEAM=teammate@company.com:approver,auditor@company.com:viewer

# --- GitHub: private-repo scanning + REAL pull requests ---
# Fine-grained PAT with Contents:read+write and Pull requests:read+write on the
# target repos (or a classic token with `repo` scope). Without it, public repos
# still scan and patches are downloadable, but PRs aren't pushed.
GITHUB_TOKEN=github_pat_...

# --- Slack / webhook alerts (drift, fix runs, PRs) ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Optional: shared store for serverless (Vercel) ---
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...
